# ════════════════════════════════════════════
# firmino.dev — Environment Variables
# ════════════════════════════════════════════

# Contact form (Resend — https://resend.com)
# Em dev, sem RESEND_API_KEY o endpoint apenas loga no console.
# Em produção, configure a chave + domínio verificado.
RESEND_API_KEY=
CONTACT_TO_EMAIL=falecom@firmino.dev
# Use o sandbox da Resend até verificar domínio próprio:
# CONTACT_FROM_EMAIL="firmino.dev <onboarding@resend.dev>"
CONTACT_FROM_EMAIL=

# Analytics — Google Analytics 4 (Measurement ID começa com G-)
NEXT_PUBLIC_GA_ID=G-XXXXXXX

# Site URL
NEXT_PUBLIC_SITE_URL=https://firmino.dev
